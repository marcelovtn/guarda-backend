# ---------------------------------------------------------------------------
# GUARDA — backend
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/guarda?schema=public"

# Connection pool (optional — defaults shown).
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=10000

# Only used by the data migration utility in src/lib/migration.ts.
# Leave empty unless you are copying data between databases.
FROM_DATABASE_URL=""
TO_DATABASE_URL=""

# --- Auth ------------------------------------------------------------------
# Public URL of this backend. Better Auth builds its callbacks from it.
BACKEND_URL="http://localhost:3001"

# Secret used to sign sessions. Generate with: openssl rand -base64 32
# Read implicitly by Better Auth — it does not appear in the source.
BETTER_AUTH_SECRET=""

# Google OAuth. Leave empty to disable the provider.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated user IDs allowed through the adminRequired middleware.
GOD_USERS=""

# Comma-separated origins allowed by CORS and trusted by Better Auth, e.g.
# "https://guarda.app,https://www.guarda.app". Required in production.
# In development any localhost port is accepted, so this can stay empty.
ALLOWED_ORIGINS=""

# Apex domain for cross-subdomain session cookies in production, e.g.
# "guarda.app". Leave empty to keep cookies scoped to the backend host.
COOKIE_DOMAIN=""

# --- Email -----------------------------------------------------------------
RESEND_API_KEY=""

# --- Storage (Cloudflare R2) ----------------------------------------------
# Used by src/lib/r2.ts for lesson videos and profile photos.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="guarda"
# Public base URL of the bucket, used to build playback/display URLs.
R2_PUBLIC_URL=""

# --- Runtime ---------------------------------------------------------------
PORT=3001
NODE_ENV="development"
LOG_LEVEL="debug"
